# Copy to .env.local for local development (`npm run dev` serves the API too), and add the
# same variables in Vercel → Settings → Environment Variables.

# ── Browser (public) ─────────────────────────────────────────────
# Clerk publishable key. Leave empty to run without sign-in (local mode, own API keys only).
VITE_CLERK_PUBLISHABLE_KEY=

# ── Server only: never prefix these with VITE_ ───────────────────
CLERK_SECRET_KEY=
# Origins allowed to call the API, comma-separated.
CLERK_AUTHORIZED_PARTIES=https://your-app.vercel.app,http://localhost:3000

# The free tier's Gemini key. It stays on the server; users never see it.
# Server storage also uses it to embed every account's documents (gemini-embedding-2, 768 dimensions).
GEMINI_API_KEY=

# Server storage: Supabase → Connect → "Transaction pooler" connection string (port 6543).
# With it set, signed-in users' documents, vectors and chats live in Postgres and sync across
# devices. Without it, everything stays in each browser.
DATABASE_URL=

# Upstash Redis for rate limits (or KV_REST_API_URL / KV_REST_API_TOKEN from the Vercel Marketplace integration).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Optional tuning ──────────────────────────────────────────────
FREE_CHAT_PER_MINUTE=10
FREE_CHAT_PER_DAY=100
# Indexing: one request embeds a batch of up to 64 chunks.
FREE_EMBED_PER_MINUTE=60
FREE_EMBED_PER_DAY=300
# Knowledge-base searches (server storage only).
FREE_SEARCH_PER_MINUTE=60
FREE_SEARCH_PER_DAY=1000
# Saves to server storage: sync pushes, new documents and text uploads.
FREE_WRITE_PER_MINUTE=120
FREE_WRITE_PER_DAY=5000
# Most characters of document text one account may store (server storage).
STORAGE_MAX_CHARS=100000000
FREE_CHAT_MODEL=gemini-3.8-flash
FREE_FAST_MODEL=gemini-3.5-flash-lite
FREE_EMBED_MODELS=gemini-embedding-2,gemini-embedding-001
